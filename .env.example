# Copy to `.env` for local dev. In production, set the same keys in Vercel → Project → Settings → Environment Variables (never commit `.env`).
#
# CISION_FEED_ID_* values are feed UniqueIdentifiers from your Cision News Feed JSON delivery (same ids shown next to each module in the delivery document).

FRAMER_PROJECT_URL=
FRAMER_API_KEY=
CRON_SECRET=

FRAMER_COLLECTION_NAME=Cision content

CISION_FEED_ID_EN_ALL=
CISION_FEED_ID_SV_ALL=
CISION_FEED_ID_EN_PRESS=
CISION_FEED_ID_SV_PRESS=
CISION_FEED_ID_EN_FINANCIAL=
CISION_FEED_ID_SV_FINANCIAL=

# Same feeds accept alternate spellings (omit lines above if you use these instead):
# CISION_FEED_ID_PRESS_EN=
# CISION_FEED_ID_PRESS_SV=
# CISION_FEED_ID_FINANCIAL_EN=
# CISION_FEED_ID_FINANCIAL_SV=

# Optional decks when feed IDs are available
# CISION_FEED_ID_DECK_EN=
# CISION_FEED_ID_DECK_SV=

# Sync: cron hits GET /api/sync with Bearer CRON_SECRET; manual POST /api/sync/run
