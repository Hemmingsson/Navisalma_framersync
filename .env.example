# Local dev: copy to `.env`. Production: set in Vercel → Project → Settings → Environment Variables.
# `.env` is gitignored — do not commit it.

# Each CISION_FEED_ID_* value is the News Feed JSON UniqueIdentifier from your Cision delivery.

FRAMER_PROJECT_URL=
FRAMER_API_KEY=
CRON_SECRET=

FRAMER_COLLECTION_NAME=Cision

CISION_FEED_ID_EN_ALL=
CISION_FEED_ID_SV_ALL=
CISION_FEED_ID_EN_PRESS=
CISION_FEED_ID_SV_PRESS=
CISION_FEED_ID_EN_FINANCIAL=
CISION_FEED_ID_SV_FINANCIAL=

# Alternate env names for the same slots (use one spelling per slot):
# CISION_FEED_ID_PRESS_EN=
# CISION_FEED_ID_PRESS_SV=
# CISION_FEED_ID_FINANCIAL_EN=
# CISION_FEED_ID_FINANCIAL_SV=

# CISION_FEED_ID_DECK_EN=
# CISION_FEED_ID_DECK_SV=

# Cron: GET /api/sync with Bearer CRON_SECRET. Manual trigger: POST /api/sync/run
