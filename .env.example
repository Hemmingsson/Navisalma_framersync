# Copy to `.env` for local dev. In production, set the same keys in Vercel → Project → Settings → Environment Variables (never commit `.env`).

FRAMER_PROJECT_URL=
FRAMER_API_KEY=
CRON_SECRET=

# Required for Cision tests: set one feed id (from Cision delivery doc).
CISION_FEED_ID=

# Optional
# CISION_FEED_ID_EN_PRESS=
# FRAMER_COLLECTION_NAME=Press Releases

# Sync (cron hits GET /api/sync with Bearer CRON_SECRET; manual POST /api/sync/run)
# Same vars in Vercel → Environment Variables.
