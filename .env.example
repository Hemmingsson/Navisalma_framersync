# Copy to `.env` locally. In Vercel: Project → Settings → Environment Variables.

FRAMER_PROJECT_URL=
FRAMER_API_KEY=
CRON_SECRET=

# Managed CMS collection name (must not clash with a user-managed collection of the same name).
FRAMER_COLLECTION_NAME=cision_feed

# Cision News Feed JSON UniqueIdentifier per module (from your delivery doc).
CISION_FEED_ID_EN_ALL=
CISION_FEED_ID_SV_ALL=
CISION_FEED_ID_EN_PRESS=
CISION_FEED_ID_SV_PRESS=
CISION_FEED_ID_EN_FINANCIAL=
CISION_FEED_ID_SV_FINANCIAL=

# Same slots, alternate names (use one name per slot):
# CISION_FEED_ID_PRESS_EN=
# CISION_FEED_ID_PRESS_SV=
# CISION_FEED_ID_FINANCIAL_EN=
# CISION_FEED_ID_FINANCIAL_SV=

# CISION_FEED_ID_DECK_EN=
# CISION_FEED_ID_DECK_SV=
